# ============================================
# 🚀 React Native Project .gitignore
# ============================================

# Node modules and dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.pnpm-debug.log*

# Build artifacts
dist/
build/
out/

# Metro bundler
.expo/
.expo-shared/
.bundle/
*.bundle
*.map

# React Native generated files
ios/build/
ios/Pods/
android/app/build/
android/app/.cxx/
android/.gradle/
android/.idea/
android/.cxx/
android/local.properties
android/.DS_Store

# Gradle files
.gradle/
build/
*.iml
*.apk
*.aar
*.dex

# Xcode
DerivedData/
*.xcworkspace
*.xcodeproj/project.xcworkspace/
*.xcuserdata/
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/

# OS generated
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
__MACOSX/

# IDE settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tests and coverage
coverage/
*.lcov

# Temporary files
*.tmp
*.swp
*.swo
*.bak

# Environment files
.env
.env.local
.env.production
.env.development

# Cache
.cache/
watchman/
watchman.json
.tmp/
*.lock
.tmp/
tmp/
*.pid

# Others
*.zip
*.tar
*.tar.gz

# ============================================
# ⚠️ Prevent pushing large media or binary files
# ============================================
*.mp4
*.mov
*.avi
*.flv
*.wmv
*.mkv
*.tiff
*.psd
*.ai
*.sketch
*.fig
*.apk
*.ipa
*.aab

# ============================================
# 🧩 Misc
# ============================================
# Optional: Firebase, fastlane, etc.
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
firebase-debug.log
